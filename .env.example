# =====================================================================
# Browse Voice Environment Configuration (.env.example)
#
# Copy this file to .env and insert your real credentials:
#   cp .env.example .env
#
# Vite will bundle these at build time (npm run build).
# You can also edit/override these keys at runtime inside the
# extension's in-app Settings dialog (⚙️ icon in the Side Panel),
# which persists them to chrome.storage.local.
# =====================================================================

# 1. Gnani AI API Credentials (https://docs.gnani.ai)
# Used for Prisma STT (Speech-to-Text) and Timbre TTS (Text-to-Speech)
VITE_GNANI_API_KEY=

# Language Code: hi-IN (Hindi), indic-auto (Auto Indic), en-IN (English), ta-IN, etc.
VITE_LANGUAGE_CODE=hi-IN

# 2. Planner LLM Configuration
# Choose: "openai-compatible" (for OpenAI, OpenRouter, DeepSeek, Groq, Ollama) or "mock"
VITE_LLM_PROVIDER=openai-compatible

# API Key for your LLM provider (e.g. sk-...)
VITE_LLM_API_KEY=

# Base Endpoint for the OpenAI-compatible API
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   Local Ollama: http://localhost:11434/v1
VITE_LLM_ENDPOINT=https://api.openai.com/v1

# Model Name
# Examples: gpt-4o-mini, deepseek-chat, llama-3.3-70b-versatile
VITE_LLM_MODEL=gpt-4o-mini
