# =====================================================================
# Browse Voice Environment Configuration (.env.example)
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# Vite bundles VITE_* vars at build time (npm run build).
# You can also set/override keys at runtime via the extension's
# Settings dialog (⚙️ icon in the Side Panel) — persisted to
# chrome.storage.local.
# =====================================================================

# 1. Gnani AI API Key (https://console.gnani.ai)
#    Required for Prisma STT and Timbre TTS.
VITE_GNANI_API_KEY=your_gnani_api_key

# Speech recognition language code
# Options: hi-IN | indic-auto | en-IN | ta-IN | te-IN | kn-IN | mr-IN
VITE_LANGUAGE_CODE=hi-IN

# ─────────────────────────────────────────────────────────────────────
# 2. Planner LLM Provider
#    Options: "gemini" | "openai-compatible" | "mock"
#
#      gemini            → Google AI Studio (free tier, recommended)
#      openai-compatible → OpenAI, OpenRouter, DeepSeek, Groq, Ollama, …
#      mock              → Offline rule-based planner (no key required)
# ─────────────────────────────────────────────────────────────────────
VITE_LLM_PROVIDER=gemini

# Google Gemini API Key (when VITE_LLM_PROVIDER=gemini)
# Get your free key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# ── OpenAI-Compatible settings (leave blank when using Gemini) ────────
# API Key (sk-... for OpenAI, or provider-specific key)
VITE_LLM_API_KEY=

# Base endpoint URL
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   DeepSeek:     https://api.deepseek.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   Local Ollama: http://localhost:11434/v1
VITE_LLM_ENDPOINT=https://api.openai.com/v1

# Model name (e.g. gpt-4o-mini, deepseek-chat, llama-3.3-70b-versatile)
VITE_LLM_MODEL=gemini-3.8-flash
