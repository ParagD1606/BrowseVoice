# =====================================================================
# Browse Voice Environment Configuration (.env.example)
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# Vite bundles VITE_* vars at build time (npm run build).
# You can also set/override keys at runtime via the extension's
# Settings dialog (⚙️ icon in the Side Panel) — persisted to
# chrome.storage.local.
# =====================================================================

# 1. Gnani AI API Key (https://console.gnani.ai)
#    Required for Prisma STT and Timbre TTS.
VITE_GNANI_API_KEY=your_gnani_api_key

# Speech recognition language code
# Options: hi-IN | indic-auto | en-IN | ta-IN | te-IN | kn-IN | mr-IN
VITE_LANGUAGE_CODE=en-IN

# ─────────────────────────────────────────────────────────────────────
# 2. Planner LLM Provider
#    Options: "gemini" | "openai-compatible" | "mock"
#
#      gemini            → Google AI Studio (free tier, recommended)
#      openai-compatible → OpenAI, OpenRouter, DeepSeek, Groq, Ollama, …
#      mock              → Offline rule-based planner (no key required)
# ─────────────────────────────────────────────────────────────────────
VITE_LLM_PROVIDER=gemini

# Google Gemini API Key (when VITE_LLM_PROVIDER=gemini)
# Get your free key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# ── OpenAI-Compatible settings (leave blank when using Gemini) ────────
# API Key (sk-... for OpenAI, or provider-specific key)
VITE_LLM_API_KEY=

# Base endpoint URL
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   DeepSeek:     https://api.deepseek.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   Local Ollama: http://localhost:11434/v1
VITE_LLM_ENDPOINT=https://api.openai.com/v1

# Model name (e.g. gpt-4o-mini, deepseek-chat, llama-3.3-70b-versatile)
VITE_LLM_MODEL=gemini-3.8-flash

# ─────────────────────────────────────────────────────────────────────
# 3. Site chat knowledge service
#    The service crawls a site's origin, creates embeddings, stores chunks
#    in a vector store, and answers questions from the indexed knowledge.
#    Leave the endpoint blank to configure it later in the extension Settings.
# ─────────────────────────────────────────────────────────────────────
VITE_SITE_CHAT_ENDPOINT=
VITE_SITE_CHAT_API_KEY=
VITE_SITE_CHAT_MAX_PAGES=25

# Backend site knowledge service (run with: npm run knowledge)
SITE_CHAT_HOST=127.0.0.1
SITE_CHAT_PORT=8787
SITE_CHAT_DATA_DIR=./backend/data
# Keep false in production. Set true only for local mock-site testing.
SITE_CHAT_ALLOW_PRIVATE_NETWORKS=false
SITE_CHAT_API_KEY=
SITE_CHAT_CORS_ORIGINS=*
# Optional reputation provider. Heuristic checks still work without this key.
SITE_SAFETY_GOOGLE_SAFE_BROWSING_KEY=

# "local" uses dependency-free feature-hash embeddings and persists vectors to JSON.
# Set "openai-compatible" plus the three values below for hosted embeddings.
SITE_CHAT_EMBEDDING_PROVIDER=local
SITE_CHAT_EMBEDDING_ENDPOINT=https://api.openai.com/v1
SITE_CHAT_EMBEDDING_API_KEY=
SITE_CHAT_EMBEDDING_MODEL=

# "none" uses extractive answers; "openai-compatible" or "gemini" enables synthesis.
SITE_CHAT_LLM_PROVIDER=none
SITE_CHAT_LLM_ENDPOINT=https://api.openai.com/v1
SITE_CHAT_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
SITE_CHAT_LLM_API_KEY=
SITE_CHAT_LLM_MODEL=
