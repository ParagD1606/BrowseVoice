{
  "manifest_version": 3,
  "name": "Browse Voice",
  "version": "1.0.0",
  "description": "Voice-controlled agentic browser assistant for Indian-language users powered by Gnani AI.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "wss://api.vachana.ai/*",
    "https://api.vachana.ai/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Browse Voice"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
